# Netlify / Cloudflare Pages style headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; media-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=3600

# Short cache: this is piped straight into a shell, so a fix to it should reach
# people quickly rather than sit in a CDN for a day. Served as plain text so it
# can be read in a browser instead of downloaded.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
